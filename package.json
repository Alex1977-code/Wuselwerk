{
  "name": "wuselwerk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wuselwerk — Echtzeit-Puzzle / Truppenrettung. MVP-Prototyp (Web).",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:single": "vite build && node scripts/build-single.mjs",
    "verify:single": "node scripts/verify-single.mjs",
    "atlas:template": "vite build && node scripts/make-atlas-template.mjs",
    "modell:messen": "node scripts/measure-model.mjs",
    "haar:messen": "node scripts/haar-messen.mjs",
    "atlas:backen": "node scripts/bake-atlas.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "lamejs": "^1.2.1",
    "playwright": "^1.49.0",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
